# ---------------------------------------------------------------------------
# Load profile configuration defining transaction characteristics and generation parameters
# ---------------------------------------------------------------------------
load-profile:
  # Random seed for reproducible transaction generation. Same seed produces same transaction sequence.
  seed: {{ loadgen_tx_seed | default(12345) }}
  # Number of worker goroutines for parallel transaction generation.
  # Higher values increase generation throughput but consume more CPU.
  # We set low values to reduce the CPU load during tests.
  workers: {{ loadgen_workers | default(ansible_facts.processor_vcpus) | int }}
  # block describes generate block characteristics
  # (when applying load to the VC or Verifier, blocks are translated to batches).
  # The generated block size is aimed to be max-size, if the generated
  # TXs rate is sufficient.
  # If the generated TXs rate is too low, the block size might
  # be less than max-size, but at least min-size.
  # In such case, the block is generated at a preferred rate of preferred-rate.
  # Blocks wait up to preferred-rate (default: 1 second) before submission.
  # If a full block is not ready by then, a partial block is
  # submitted if it meets min-size (default: 1);
  # otherwise, the system waits until min-size is available.
  # If the max-size is less than or equal to min-size, preferred-rate is ignored.
  block:
    max-size: {{ loadgen_block_max_size | default(500) }}
    min-size: {{ loadgen_block_min_size | default(1) }}
    preferred-rate: {{ loadgen_block_preferred_rate | default('1s') }}
  # Transaction structure configuration.
  # Each transaction can contain three types of key operations:
  #   - read-only: Reads a key without writing (version is nil).
  #   - read-write: Reads and writes a key (read version is nil).
  #   - blind-write (write-count): Writes a key without reading it first.
  transaction:
    # Size of generated keys in bytes. Affects transaction payload size and storage requirements.
    key-size: {{ loadgen_key_size | default(32) }}
{% if loadgen_generate_read_only_tx | default(false) %}
    # Number of read-only operations per transaction.
    read-only-count: {{ loadgen_read_only_tx_keys | default(2) }}
{% endif %}
{% if loadgen_generate_write_only_tx | default(false) %}
    # Number of blind-write operations per transaction.
    write-count: {{ loadgen_write_only_tx_keys | default(2) }}
    # Size in bytes of the value written for each blind-write operation (0 means nil value).
    blind-write-value-size: {{ loadgen_write_only_tx_val_size | default(32) }}
{% endif %}
{% if loadgen_generate_read_write_tx | default(true) %}
    # Number of read-write operations per transaction.
    read-write-count: {{ loadgen_read_write_tx_keys | default(2) }}
    # Size in bytes of the value written for each read-write operation (0 means nil value).
    read-write-value-size: {{ loadgen_read_write_tx_val_size | default(32) }}
{% endif %}
{% if loadgen_invalid_signatures_rate is defined %}
    # Fraction of transactions to generate with invalid signatures (0.0 to 1.0).
    invalid-signatures: {{ loadgen_invalid_signatures_rate }}
{% endif %}
{% if loadgen_key_backref_rate is defined %}
    # Fraction of transactions whose keys back-reference an earlier transaction.
    key-backref-rate: {{ loadgen_key_backref_rate }}
{% endif %}
{% if loadgen_tx_reference_gap is defined %}
    # Distance, in transaction count, between a transaction and the earlier one
    # it back-references.
    tx-reference-gap: {{ loadgen_tx_reference_gap }}
{% endif %}
{% if loadgen_key_lookback_window is defined %}
    # Number of prior transactions eligible as a back-reference source.
    key-lookback-window: {{ loadgen_key_lookback_window }}
{% endif %}
  # Policy configuration for transaction endorsement and validation
  policy:
    # Channel ID for which transactions are generated. Must match the target blockchain channel.
    channel-id: {{ channel_id }}
    # Namespace-specific endorsement policies. Key is namespace ID (0 for default namespace).
    # Each namespace can have different signature schemes and endorsement requirements.
    # System namespaces (meta and config) must not be specified; their policies are derived
    # from the config block automatically.
    #
    # Supported schemes:
    #   ECDSA, EDDSA, BLS - Use synthetic identities generated from 'seed' (or loaded from 'key-path').
    #                        No Fabric PKI required. Useful for performance testing.
    #   MSP               - Uses Fabric's standard endorsement with signing identities loaded from
    #                        artifacts-path. Requires all peer organizations to sign. The 'seed' and
    #                        'key-path' fields are ignored when using MSP.
    namespace-policies:
{% if organization.namespaces is defined %}
{% for current_namespace in organization.namespaces %}
        # Namespace identifier
        {{ current_namespace.id }}:
          # Signature scheme ("ECDSA", "EDDSA", "BLS" or "NONE").
          scheme: {{ loadgen_key_scheme | default('ECDSA') }}
          # How to find/generate the signature keys.
          key-path:
{% set namespace_user = (organization.users | first) %}
            # Path to the signing key.
            signing-key: {{ loadgen_config_dir }}/users/{{ namespace_user.name }}@{{ organization.domain }}/msp/keystore/priv_sk
            # Path to the signing certificate.
            sign-certificate: {{ loadgen_config_dir }}/users/{{ namespace_user.name }}@{{ organization.domain }}/msp/signcerts/{{ namespace_user.name }}@{{ organization.domain }}-cert.pem
{% endfor %}
{% endif %}
{% if loadgen_generate_config_block %}
    # Orderer endpoint specifications for transaction submission.
    # Format: id=<num>,msp-id=<org>,broadcast,deliver,<host>:<port>
    # Capabilities: 'broadcast' (submit txs), 'deliver' (receive blocks).
    orderer-endpoints:
{% for orderer_router in orderer_router_hosts %}
      - id={{ hostvars[orderer_router].orderer_group }},msp-id={{ hostvars[orderer_router].organization.name }},broadcast,{{ hostvars[orderer_router].ansible_host }}:{{ hostvars[orderer_router].orderer_rpc_port }}
{% endfor %}
{% for orderer_assembler in orderer_assembler_hosts %}
      - id={{ hostvars[orderer_assembler].orderer_group }},msp-id={{ hostvars[orderer_assembler].organization.name }},deliver,{{ hostvars[orderer_assembler].ansible_host }}:{{ hostvars[orderer_assembler].orderer_rpc_port }}
{% endfor %}
{% endif %}
{% if loadgen_query_settings is defined %}
  # Describe query characteristics.
  query:
    # The number of keys to query.
    query-size: {{ loadgen_query_settings.size | default(1) }}
    # The minimal portion of invalid keys (1 => all keys are invalid).
    # This is a lower bound since some valid keys might have failed to commit due to conflicts.
    min-invalid-keys-portion: {{ loadgen_query_settings.min_invalid_keys_portion | default(1) }}
    # If Shuffle=false, the valid keys will be placed first.
    # Otherwise, they will be shuffled.
    shuffle: {{ loadgen_query_settings.shuffle | default(false) | bool | lower }}
{% endif %}
