# Admin identity used to authenticate and sign fxadmin operations
msp:
  localMspID: {{ fxadmin_msp_id }}
  localMspDir: {{ fxadmin_config_dir }}/msp

# TLS/mTLS settings for the connection discovered from the reference config block
tls:
  enabled: {{ fxadmin_use_tls | default(false) | lower }}
{% if fxadmin_use_mtls | default(false) %}
  clientCert: {{ fxadmin_config_dir }}/mtls/client.crt
  clientKey: {{ fxadmin_config_dir }}/mtls/client.key
{% endif %}
