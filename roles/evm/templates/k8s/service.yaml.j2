---
apiVersion: v1
kind: Service
metadata:
  name: {{ evm_k8s_resource_name }}
  labels:
    app.kubernetes.io/name: {{ evm_k8s_resource_name }}
    app.kubernetes.io/component: evm
    app.kubernetes.io/part-of: {{ evm_k8s_part_of }}
spec:
  # Headless Service — required by the StatefulSet for stable DNS-based pod addressing.
  clusterIP: None
  selector:
    app.kubernetes.io/name: {{ evm_k8s_resource_name }}
  ports:
    - name: rest
      port: {{ evm_port }}
      targetPort: {{ evm_port }}
