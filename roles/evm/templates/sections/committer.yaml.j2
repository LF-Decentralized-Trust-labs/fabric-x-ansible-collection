# ---------------------------------------------------------------------------
# Committer configuration
# Committer sidecar this process synchronizes with for block delivery. A
# single stream feeds both the gateway and the embedded endorser.
# ---------------------------------------------------------------------------
committer:
  endpoint:
    host: {{ hostvars[sidecar_host].ansible_host }}
    port: {{ hostvars[sidecar_host].committer_rpc_port }}
{% if (hostvars[sidecar_host].committer_use_tls is defined) and hostvars[sidecar_host].committer_use_tls %}
  tls:
{% if (hostvars[sidecar_host].committer_use_mtls is defined) and hostvars[sidecar_host].committer_use_mtls %}
    mode: mtls
    cert-path: {{ evm_container_config_dir }}/tls/server.crt
    key-path: {{ evm_container_config_dir }}/tls/server.key
{% else %}
    mode: tls
{% endif %}
    ca-cert-paths:
      - {{ evm_container_config_dir }}/tls/sidecar/ca.crt
{% endif %}
