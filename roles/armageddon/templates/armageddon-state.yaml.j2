# Persists the fingerprint of the current Armageddon inputs (rendered shared_config.yaml and
# the fetched orderer crypto tree) so the next run can detect whether they changed. Written
# unconditionally on every run, whether or not Armageddon actually executed.
fingerprint: "{{ armageddon_input_fingerprint }}"
