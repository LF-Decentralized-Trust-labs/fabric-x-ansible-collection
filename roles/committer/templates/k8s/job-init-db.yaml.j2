---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ committer_k8s_resource_name }}-init-db
  labels:
    app.kubernetes.io/name: {{ committer_k8s_resource_name }}
    app.kubernetes.io/component: {{ committer_component_type }}
    app.kubernetes.io/part-of: {{ committer_k8s_part_of }}
spec:
  backoffLimit: 0
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ committer_k8s_resource_name }}
        app.kubernetes.io/component: {{ committer_component_type }}
        app.kubernetes.io/part-of: {{ committer_k8s_part_of }}
    spec:
      restartPolicy: Never
      securityContext:
        fsGroup: {{ committer_k8s_fs_group }}
      containers:
        - name: init-db
          image: {{ committer_image }}
          args:
            - "init-db"
            - "--config={{ committer_container_config_dir }}/{{ committer_config_file }}"
            - "--timeout={{ committer_init_db_timeout }}"
          volumeMounts:
            - name: config
              mountPath: {{ committer_container_config_dir }}/{{ committer_config_file }}
              subPath: config-validator.yml
{% if committer_use_tls %}
            - name: secret
              mountPath: {{ committer_container_config_dir }}/tls/server.key
              subPath: tls-server.key
              readOnly: true
            - name: secret
              mountPath: {{ committer_container_config_dir }}/tls/server.crt
              subPath: tls-server.crt
              readOnly: true
            - name: secret
              mountPath: {{ committer_container_config_dir }}/tls/ca.crt
              subPath: tls-ca.crt
              readOnly: true
{% endif %}
{% if postgres_db_host is defined and hostvars[postgres_db_host].postgres_use_tls is defined and hostvars[postgres_db_host].postgres_use_tls %}
            - name: config
              mountPath: {{ committer_container_config_dir }}/tls/db/ca.crt
              subPath: tls-db-ca.crt
              readOnly: true
{% elif yugabyte_cluster_ref_id is defined %}
{% set yugabyte_cluster_ref_host = groups['all'] | map('extract', hostvars) | selectattr('yugabyte_cluster_id', 'defined') | selectattr('yugabyte_cluster_id', '==', yugabyte_cluster_ref_id) | map(attribute='inventory_hostname') | first %}
{% if hostvars[yugabyte_cluster_ref_host].yugabyte_use_tls is defined and hostvars[yugabyte_cluster_ref_host].yugabyte_use_tls %}
            - name: config
              mountPath: {{ committer_container_config_dir }}/tls/db/ca.crt
              subPath: tls-db-ca.crt
              readOnly: true
{% endif %}
{% endif %}
      volumes:
        - name: config
          configMap:
            name: {{ committer_k8s_resource_name }}-config
            defaultMode: 0640
{% if committer_use_tls %}
        - name: secret
          secret:
            secretName: {{ committer_k8s_resource_name }}-secret
            defaultMode: 0640
{% endif %}
{% if k8s_image_pull_secret is defined and k8s_image_pull_secret %}
      imagePullSecrets:
        - name: {{ k8s_image_pull_secret }}
{% endif %}
