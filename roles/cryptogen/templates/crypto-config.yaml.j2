{% if cryptogen_orgs_by_domain.items() | length > 0 %}
# ---------------------------------------------------------------------------
# "GenericOrgs" - Definition of organizations managing any organizational unit.
# Each node's organizational unit (OU) is set explicitly, allowing a single
# organization to own both orderer and peer nodes.
# ---------------------------------------------------------------------------
GenericOrgs:
{% for org_domain, org_info in cryptogen_orgs_by_domain.items() %}
  # ---------------------------------------------------------------------------
  # {{ org_info.name }}
  # ---------------------------------------------------------------------------
  - Name: {{ org_info.name }}
    Domain: {{ org_info.domain }}
    EnableNodeOUs: true
{% if org_info.nodes is defined and org_info.nodes | length > 0 %}
    # ---------------------------------------------------------------------------
    # "Specs"
    # ---------------------------------------------------------------------------
    # Specs is an array of Spec entries.  Each Spec entry consists of three fields:
    #   - Hostname:           (Required) The desired hostname, sans the domain.
    #   - OrganizationalUnit: (Required) Selects the node's OU ("orderer" or "peer"),
    #                         which also selects its output subtree.
    #   - CommonName:         (Optional) Specifies the template or explicit override
    #                         for the CN.  By default, this is the template:
    #
    #                              "Hostname.Domain"
    #
    #                         which obtains its values from the Spec.Hostname and
    #                         Org.Domain, respectively.
    Specs:
{% for node in org_info.nodes %}
      - Hostname: {{ hostvars[node.name].organization[node.ou].name | default(node.name) }}
        OrganizationalUnit: {{ node.ou }}
        SANS:
{% for node_ip in (hostvars[node.name].ansible_facts.all_ipv4_addresses | sort) %}
          - {{ node_ip }}
{% endfor %}
          - {{ hostvars[orderer.name].ansible_host }}
          - {{ hostvars[orderer.name].actual_host }}
{% if hostvars[orderer.name].organization.orderer.additional_sans is defined %}
{% for additional_san in hostvars[orderer.name].organization.orderer.additional_sans %}
          - {{ additional_san }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

    # ---------------------------------------------------------------------------
    # "Users"
    # ---------------------------------------------------------------------------
    # Only non-admin users are listed under Specs: cryptogen hard-codes OU=client
    # for every Specs entry regardless of name, so an "admin"-type entry here
    # would silently fail to satisfy the channel's per-org Admins policy (which
    # requires OU=admin). The only way to obtain an OU=admin identity is
    # cryptogen's own implicit, automatically-generated Admin@<domain> user
    # (unconditional, not driven by this Users block at all) -- see
    # roles/fxadmin/tasks/crypto/cryptogen/transfer.yaml, which fetches an
    # admin-type identity from that fixed name regardless of what it is
    # called in organization.users.
    Users:
      # Count: The number of user accounts _in addition_ to Admin
      Count: 0
{% set orderer_org_non_admin_users = [] %}
{% for user in (orderer_org_info.users | default([]) | unique) %}
{% if (user.type | default('client')) != 'admin' %}
{% set _ = orderer_org_non_admin_users.append(user) %}
{% endif %}
{% endfor %}
{% if orderer_org_non_admin_users | length > 0 %}
      # ---------------------------------------------------------------------------
      # "Specs"
      # ---------------------------------------------------------------------------
      # Specs is an array of Spec entries.  Each Spec entry consists of two fields:
      #   - Name:   (Required) The desired name for the user.
      #
      # ---------------------------------------------------------------------------
      Specs:
{% for user in orderer_org_non_admin_users %}
        - Name: {{ user.name }}
          HSM: false
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

{% if cryptogen_peers_by_org.items() | length > 0 %}
# ---------------------------------------------------------------------------
# "PeerOrgs" - Definition of organizations managing peer nodes
# ---------------------------------------------------------------------------
PeerOrgs:
{% for peer_org_domain, peer_org_info in cryptogen_peers_by_org.items() %}
  # ---------------------------------------------------------------------------
  # {{ peer_org_info.name }}
  # ---------------------------------------------------------------------------
  - Name: {{ peer_org_info.name }}
    Domain: {{ peer_org_info.domain }}
    EnableNodeOUs: true
{% if peer_org_info.peers is defined and peer_org_info.peers | length > 0 %}
    # ---------------------------------------------------------------------------
    # "Specs"
    # ---------------------------------------------------------------------------
    # Uncomment this section to enable the explicit definition of hosts in your
    # configuration.  Most users will want to use Template, below
    #
    # Specs is an array of Spec entries.  Each Spec entry consists of two fields:
    #   - Hostname:   (Required) The desired hostname, sans the domain.
    #   - CommonName: (Optional) Specifies the template or explicit override for
    #                 the CN.  By default, this is the template:
    #
    #                              ".Hostname.Domain"
    #
    #                 which obtains its values from the Spec.Hostname and
    #                 Org.Domain, respectively.
    #   - SANS:       (Optional) Specifies one or more Subject Alternative Names
    #                 to be set in the resulting x509. Accepts template
    #                 variables .Hostname, .Domain, .CommonName. IP
    #                 addresses provided here will be properly recognized. Other
    #                 values will be taken as DNS names.
    #                 NOTE: Two implicit entries are created for you:
    #                     - .CommonName
    #                     - .Hostname
    # ---------------------------------------------------------------------------
    Specs:
{% for peer in (peer_org_info.peers | unique) %}
      - Hostname: {{ hostvars[peer.name].organization.peer.name | default(peer.name) }}
        SANS:
{% for peer_ip in (hostvars[peer.name].ansible_facts.all_ipv4_addresses | sort) %}
          - {{ peer_ip }}
{% endfor %}
          - {{ hostvars[peer.name].ansible_host }}
          - {{ hostvars[peer.name].actual_host }}
{% if hostvars[node.name].organization[node.ou].additional_sans is defined %}
{% for additional_san in hostvars[node.name].organization[node.ou].additional_sans %}
          - {{ additional_san }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

    # ---------------------------------------------------------------------------
    # "Users"
    # ---------------------------------------------------------------------------
    Users:
      # Count: The number of user accounts _in addition_ to Admin
      Count: 1
{% if org_info.users is defined and org_info.users | length > 0 %}
      # ---------------------------------------------------------------------------
      # "Specs"
      # ---------------------------------------------------------------------------
      # Specs is an array of Spec entries.  Each Spec entry consists of two fields:
      #   - Name:  (Required) The desired name for the user.
      #   - Admin: (Optional) Generates an administrator when true.
      #
      # ---------------------------------------------------------------------------
      Specs:
{% for user in (org_info.users | unique) %}
        - Name: {{ user.name }}
{% if user.type | default('client') == 'admin' %}
          Admin: true
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
