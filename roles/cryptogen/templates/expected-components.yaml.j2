# Derives the set of MSP/TLS components "cryptogen" is expected to produce from the
# already-rendered crypto-config.yaml (cryptogen_rendered_config), mirroring the path and
# Common Name derivation of fabric-x-common/tools/cryptogen (newOrgCryptoTree, subNode,
# renderNodeSpec, generateUsers, adminUser). Each entry is later stat-ed on disk to detect
# missing components, and non-null fingerprints are compared against a persisted state file
# to detect components whose spec changed (for example, a node's SANS) and therefore need
# re-issuing. Organizations carry no fingerprint: they either exist or they do not.
#
# Only the shapes crypto-config.yaml.j2 actually renders are walked here: GenericOrgs, each
# with Specs and Users. A node's OrganizationalUnit picks its subtree exactly like cryptogen's
# subNode(): "orderer" -> orderers/, "peer" -> peers/, anything else -> users/.
{% for org in cryptogen_rendered_config.GenericOrgs | default([]) %}
- kind: org
  org: {{ org.Domain | to_json }}
  dir: {{ ('organizations/' ~ org.Domain) | to_json }}
  fingerprint: null
{% for spec in org.Specs | default([]) %}
{% set cn = spec.CommonName | default(spec.Hostname ~ '.' ~ org.Domain) %}
{% set pubkey = spec.PublicKeyAlgorithm | default('ecdsa') %}
{% set sans = spec.SANS | default([]) | sort %}
{% if spec.OrganizationalUnit == 'orderer' %}
{% set node_kind = 'orderer' %}
{% set node_dir = 'orderers' %}
{% elif spec.OrganizationalUnit == 'peer' %}
{% set node_kind = 'peer' %}
{% set node_dir = 'peers' %}
{% else %}
{% set node_kind = 'user' %}
{% set node_dir = 'users' %}
{% endif %}
- kind: {{ node_kind }}
  org: {{ org.Domain | to_json }}
  name: {{ cn | to_json }}
  dir: {{ ('organizations/' ~ org.Domain ~ '/' ~ node_dir ~ '/' ~ cn) | to_json }}
  fingerprint: {{ (cn ~ '|' ~ (sans | join(',')) ~ '|' ~ pubkey) | hash('sha1') | to_json }}
{% endfor %}
{% set admin_cn = 'Admin@' ~ org.Domain %}
- kind: user
  org: {{ org.Domain | to_json }}
  name: {{ admin_cn | to_json }}
  dir: {{ ('organizations/' ~ org.Domain ~ '/users/' ~ admin_cn) | to_json }}
  fingerprint: {{ (admin_cn ~ '|ecdsa') | hash('sha1') | to_json }}
{% set users_pubkey = org.Users.PublicKeyAlgorithm | default('ecdsa') %}
{% for i in range(1, (org.Users.Count | default(0)) + 1) %}
{% set user_cn = 'User' ~ i ~ '@' ~ org.Domain %}
- kind: user
  org: {{ org.Domain | to_json }}
  name: {{ user_cn | to_json }}
  dir: {{ ('organizations/' ~ org.Domain ~ '/users/' ~ user_cn) | to_json }}
  fingerprint: {{ (user_cn ~ '|' ~ users_pubkey) | hash('sha1') | to_json }}
{% endfor %}
{% for user_spec in org.Users.Specs | default([]) %}
{% set user_cn = user_spec.Name ~ '@' ~ org.Domain %}
- kind: user
  org: {{ org.Domain | to_json }}
  name: {{ user_cn | to_json }}
  dir: {{ ('organizations/' ~ org.Domain ~ '/users/' ~ user_cn) | to_json }}
  fingerprint: {{ (user_cn ~ '|' ~ users_pubkey) | hash('sha1') | to_json }}
{% endfor %}
{% endfor %}
